# --- Brain ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Default model for every turn (see docs/JARVIS-PLAN.md §4.6 for the tiering rationale)
JARVIS_MODEL_DEFAULT=claude-opus-5
# Optional cheaper/faster tier used by the router for short chit-chat and device control
JARVIS_MODEL_FAST=claude-sonnet-5
# Turn the router on to let simple turns use JARVIS_MODEL_FAST (off = always the default model)
JARVIS_ROUTER_ENABLED=false
# Effort for conversational turns (low|medium|high|xhigh|max); escalated turns use JARVIS_EFFORT_COMPLEX
JARVIS_EFFORT_CHAT=medium
JARVIS_EFFORT_COMPLEX=high
# Server-side refusal fallbacks (recommended on Claude Opus 5 / Fable 5.1)
JARVIS_FALLBACKS=true
# Anthropic server-side web search tool ($10 per 1,000 searches)
JARVIS_WEB_SEARCH=false
JARVIS_WEB_SEARCH_MAX_USES=3

# --- Persona -------------------------------------------------------------
JARVIS_ASSISTANT_NAME=Jarvis
JARVIS_OWNER_NAME=
JARVIS_HOME_TIMEZONE=UTC
JARVIS_LANGUAGE=en
# Household members as Name:role (owner|adult|child|guest)
JARVIS_USERS=Owner:owner,Guest:guest

# --- Home Assistant (optional) ------------------------------------------
HA_URL=
HA_TOKEN=
# Comma-separated entity_ids exposed to the assistant (empty = all readable; writes still go through policy)
HA_EXPOSED_ENTITIES=

# --- Messaging (optional) -----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Server --------------------------------------------------------------
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8080
JARVIS_DATA_DIR=./data
# Dashboard access token (recommended when not on localhost); empty = no auth
JARVIS_DASHBOARD_TOKEN=
# Seconds an "ask"-tier tool call waits for approval before it is denied
JARVIS_APPROVAL_TIMEOUT=120

# --- Voice ---------------------------------------------------------------
# browser | faster_whisper   (browser = the dashboard's Web Speech API does STT)
JARVIS_STT=browser
# browser | kokoro           (browser = the dashboard's speechSynthesis does TTS)
JARVIS_TTS=browser
JARVIS_WAKE_WORD=jarvis
